# Copy this file to .env and fill in the values from
# Supabase -> Project Settings -> API Keys
# Use the PUBLISHABLE key (sb_publishable_...) or the legacy "anon" key (eyJ...).
# NEVER use the secret key (sb_secret_...) or service_role key here –
# everything in VITE_ variables is visible to anyone in the browser.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
